<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="612.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.isep.ead.controllers.crud.BuildingCrudController">
    <children>

        <Label fx:id="nameOrga" text="Nom batiment">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <StackedBarChart title="Consomation énergétique du bâtiment">
            <xAxis>
                <CategoryAxis label="Type d'énergie" side="BOTTOM" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Consomation(kWh)" side="LEFT" />
            </yAxis>
        </StackedBarChart>

        <HBox alignment="CENTER" prefHeight="51.0" prefWidth="740.0" spacing="15.0">
         <children>
            <VBox prefHeight="52.0" prefWidth="152.0" style="-fx-background-color: #008000; -fx-background-radius: 10; -fx-padding: 15;">
               <children>
                  <Label prefHeight="17.0" prefWidth="107.0" text="Types d'énergie :" textFill="#fffefe">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
                  <Label text="Label" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font></Label>
               </children></VBox>
            <VBox prefHeight="82.0" prefWidth="201.0" style="-fx-background-color: #008000; -fx-background-radius: 10; -fx-padding: 15;">
               <children>
                  <Label text="Consomation totale mensuel" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
                  <Label prefHeight="17.0" prefWidth="86.0" text="Label" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font></Label>
               </children>
            </VBox>
            <VBox prefHeight="52.0" prefWidth="155.0" style="-fx-background-radius: 10; -fx-background-color: WHITE; -fx-padding: 15;">
               <children>
                  <Label text="Coût mensuel">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
                  <Label prefHeight="35.0" prefWidth="70.0" text="Label">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font></Label>
               </children>
            </VBox>
         </children></HBox>

    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
