<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="850.0" prefWidth="1200.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.isep.ead.controllers.EnergyCompareController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Consomation " textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Comparez vos infrastructures et estimez vos consommations et coûts futurs." textFill="#7f8c8d" />
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>

                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #dcdde1; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                    <children>
                        <BarChart fx:id="compareBarChart" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxisMetrics" label="Valeurs" side="LEFT" />
                            </yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <VBox prefWidth="340.0" spacing="12.0" style="-fx-background-color: #008000; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;">
                    <children>
                        <Label text="FILTRES ">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Separator prefWidth="200.0" />

                        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Organisations et Bâtiments" />
                                <TreeView fx:id="treeOrganizationsAndBuildings" style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 5;" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #eee;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Énergies à comparer (Sélection multiple)" />
                                <GridPane hgap="15.0" vgap="8.0">
                                    <children>
                                        <CheckBox fx:id="chkElectricity" mnemonicParsing="false" text="Électricité" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <CheckBox fx:id="chkGas" mnemonicParsing="false" text="Gaz" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <CheckBox fx:id="chkWater" mnemonicParsing="false" text="Eau" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <CheckBox fx:id="chkHeating" mnemonicParsing="false" text="Chauffage" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <CheckBox fx:id="chkCooling" mnemonicParsing="false" text="Climatisation" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <CheckBox fx:id="chkSolar" mnemonicParsing="false" text="Solaire" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                           <columnConstraints>
                              <ColumnConstraints />
                              <ColumnConstraints />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                           </rowConstraints>
                                </GridPane>
                            </children>
                        </VBox>

                        <VBox spacing="5.0" style="-fx-background-color: #f8f9fa; -fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #eee;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Période d'analyse" />
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <DatePicker fx:id="dateStart" prefHeight="30.0" promptText="Début" HBox.hgrow="ALWAYS" />
                                        <Label text="à" textFill="#7f8c8d" />
                                        <DatePicker fx:id="dateEnd" prefHeight="30.0" promptText="Fin" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Separator prefWidth="200.0" />

                        <Label text="ESTIMATIONS FUTURES">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <VBox spacing="8.0" style="-fx-background-color: #e8f4f8; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #3498db; -fx-border-width: 0.5;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="Date" />
                                <ComboBox fx:id="comboForecastPeriod" maxWidth="1.7976931348623157E308" prefHeight="30.0" promptText="Choisir l'échéance" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 4;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Mois suivant (M+1)" />
                                            <String fx:value="Semestre suivant (M+6)" />
                                            <String fx:value="Année suivante (A+1)" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="btnForecastEnergy" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleForecastEnergy" prefHeight="32.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;" text="Estimer Conso. Futur" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnForecastCost" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleForecastCost" prefHeight="32.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;" text="Estimer Coût Futur" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Separator prefWidth="200.0" />

                        <Button fx:id="btnApplyCompare" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleApplyCompare" prefHeight="40.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand;" text="Lancer l'Analyse" />
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</VBox>
