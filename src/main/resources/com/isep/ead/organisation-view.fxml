<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.isep.ead.controllers.OrganizationCrudController">
    <children>

        <Label text="Gestion des Organisations">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <HBox spacing="15.0">
            <children>
                <Button fx:id="btnCreate" alignment="CENTER_RIGHT" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#handleCreateOrganization" prefHeight="46.0" prefWidth="46.0" style="-fx-background-color: #008000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-cursor: hand;" text="+" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="Arial Bold" size="24.0" />
               </font>
                </Button>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #ecf0f1;" VBox.vgrow="ALWAYS">
            <content>
                <TilePane fx:id="organizationsGrid" hgap="30.0" prefColumns="4" vgap="30.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>

    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
