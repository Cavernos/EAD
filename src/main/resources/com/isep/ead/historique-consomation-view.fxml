<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox prefHeight="750.0" prefWidth="1050.0" spacing="20.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.isep.ead.controllers.ConsomationController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>

      <VBox spacing="5.0">
         <children>
            <Label text="Historique des Consommations">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #008000; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
         <children>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" text="ORGANISATION" textFill="WHITE" />
                  <ComboBox fx:id="comboOrganization" prefWidth="200.0" promptText="Sélectionner l'orga" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" text="BÂTIMENT" textFill="WHITE" />
                  <ComboBox fx:id="comboBuilding" prefWidth="200.0" promptText="Tous les bâtiments" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" text="PÉRIODE" textFill="WHITE" />
                  <ComboBox fx:id="comboPeriod" prefWidth="180.0" promptText="Choisir la période" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <HBox HBox.hgrow="ALWAYS" />

            <VBox alignment="BOTTOM_CENTER">
               <children>
                  <Button fx:id="btnApplyFilters" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #1a8ae5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="🔍 Filtrer" textFill="#1a8ae5" />
               </children>
            </VBox>

         </children>
      </HBox>

      <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);" VBox.vgrow="ALWAYS">
         <children>
            <TableView style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDate" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Date du Relevé" />
                  <TableColumn fx:id="colBuilding1" prefWidth="220.0" style="-fx-alignment: CENTER_LEFT;" text="Organisation" />
                  <TableColumn fx:id="colBuilding" prefWidth="220.0" style="-fx-alignment: CENTER_LEFT;" text="Bâtiment / Local" />
                  <TableColumn fx:id="colEnergy" prefWidth="140.0" style="-fx-alignment: CENTER;" text=" Type d'Énergie" />
                  <TableColumn fx:id="colAmount" prefWidth="160.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;" text="Quantité Consommée" />
                  <TableColumn fx:id="colCost" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT; -fx-text-fill: #2ecc71; -fx-font-weight: bold;" text="Coût Estimé (€)" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

   </children>
</VBox>
